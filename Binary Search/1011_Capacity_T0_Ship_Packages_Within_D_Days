class Solution(object):
    def shipWithinDays(self, weights, days):
        left = max(weights)
        right = sum(weights)
        while left <= right :
            mid = (left+right)//2

            days_need = 1
            current_weight = 0
            for weight in weights :
                if current_weight + weight > mid :
                    days_need += 1
                    current_weight = weight
                else :
                    current_weight += weight
            
            if days_need > days :
                left = mid+1
            else :
                right = mid-1
        return left