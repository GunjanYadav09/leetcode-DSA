class Solution(object):
    def maxDistance(self, position, m):
        position.sort()

        left = 1
        right = position[-1] - position[0]

        while left <= right :
            mid = (left+right)//2

            balls = 1
            last_pos = position[0]

            for pos in position[1:] :
                if pos-last_pos >= mid:
                    balls += 1
                    last_pos = pos
            if balls >= m :
                left = mid+1
            else :
                right = mid-1
        return right       