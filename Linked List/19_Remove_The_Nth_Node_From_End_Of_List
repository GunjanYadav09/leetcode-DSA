class Solution(object):
    def removeNthFromEnd(self, head, n):
        dummy = ListNode(0)
        dummy.next = head

        slow = dummy
        fast = dummy

        # move fast ahead by n+1 steps
        for i in range(n+1):
            fast = fast.next

        # move both pointers together
        while fast is not None:
            slow = slow.next
            fast = fast.next

        # Remove the required node
        slow.next = slow.next.next

        return dummy.next