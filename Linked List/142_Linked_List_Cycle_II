class Solution(object):
    def detectCycle(self, head):
        slow = head 
        fast = head
        while fast is not None and fast.next is not None:
            slow = slow.next
            fast = fast.next.next

            if slow is fast:
                break 
        else:
            return None
        slow = head
        while slow is not fast:
            slow = slow.next
            fast = fast.next
        return slow